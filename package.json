{
  "name": "mymusic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "test": "vitest run --passWithNoTests",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mymusic --local",
    "db:migrate": "wrangler d1 migrations apply mymusic --remote",
    "release:android": "node scripts/android-release.mjs",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.app.json && vite build"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "music-metadata": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}