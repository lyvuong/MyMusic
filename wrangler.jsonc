{
	"name": "mymusic",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		],
		"binding": "ASSETS"
	},
	"vars": {
		"FIREBASE_PROJECT_ID": "mymusic-3149e",
		// NAS (Navidrome/Subsonic) behind a Cloudflare Tunnel. Empty = NAS disabled.
		"NAS_BASE_URL": "https://navidrome.lv5.uk",
		// The home server API (scripts/unraid/mymusic-api) behind a Cloudflare Tunnel; protected by the same Access service token.
		// Empty = import, enrich and name editing are disabled in the app.
		"HOME_API_URL": "https://mymusic-api.lv5.uk"
	},
	"r2_buckets": [
		{
			"binding": "MUSIC",
			"bucket_name": "mymusic-files"
		},
		{
			"binding": "RELEASES",
			"bucket_name": "mymusic-releases"
		}
	],
	// Workers AI for the rating-based suggestions (free daily allowance)
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mymusic",
			"database_id": "eb35b4c2-3014-470b-a097-3ca96f2ead06",
			"migrations_dir": "migrations"
		}
	],
	// Secrets: NAS_CF_ACCESS_ID, NAS_CF_ACCESS_SECRET, NAS_USER, NAS_PASSWORD
	"observability": {
		"enabled": true
	}
}